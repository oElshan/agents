{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [".opencode/framework.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      ".agents/board/**": "deny",
      ".agents/cache/**": "deny"
    },
    "external_directory": "ask"
  },
  "policies": [
    { "action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * +*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * :*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -d *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -d *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--mirror*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--prune*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -C *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -c *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git --git-dir*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git --work-tree*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset *--hard*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout * .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git switch -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git switch *--discard-changes*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git restore .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git restore * .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -D*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch * -D*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch * -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash drop*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash clear*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-branch*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-repo*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reflog expire*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reflog delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git update-ref -d*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git update-ref * -d*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git gc *--prune*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm /*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm * /*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *~*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *$HOME*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *.git", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *.git *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:doas *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bash -c*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bash -lc*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sh -c*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sh -lc*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:zsh -c*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:zsh -lc*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:eval *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:kubectl delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:kubectl * delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:helm uninstall*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:helm * uninstall*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:helm delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:helm * delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker system prune*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker volume rm*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:docker volume prune*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh repo delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh repo archive*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api *DELETE*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api *delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr merge*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh issue delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh project delete*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh release delete*", "effect": "deny" },

    { "action": "integration.use", "resource": "skill:*", "effect": "deny" },
    { "action": "integration.use", "resource": "skill:angular", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:board", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:db-migration", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:deploy-staging", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:design-change", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:e2e-playwright", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:frontend-review", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:github-sync", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:java-review", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:java-spring", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:project-setup", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:quality-gates", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:react-fsd", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:sdc", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:security-review", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:verify-ac", "effect": "allow" },
    { "action": "integration.use", "resource": "skill:write-spec", "effect": "allow" }
  ]
}
